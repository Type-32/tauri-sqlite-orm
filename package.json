{
    "name": "@type32/tauri-sqlite-orm",
    "version": "0.4.1-2",
    "description": "A Drizzle-like ORM for Tauri v2's SQL JS API plugin.",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts",
        "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
        "test": "bun test",
        "release:minor": "bun run build && bun pm version minor && bun publish",
        "release:prerelease": "bun run build && bun pm version prerelease && bun publish",
        "release:patch": "bun run build && bun pm version patch && bun publish"
    },
    "keywords": [
        "tauri",
        "sqlite",
        "orm",
        "drizzle"
    ],
    "author": "Type-32",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^25.4.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@tauri-apps/plugin-sql": "^2.3.2",
        "kysely": "^0.28.11"
    }
}
